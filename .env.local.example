# Credenciais do app no Spotify Developer Dashboard (Client Credentials Flow).
# Copie para .env.local e preencha:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mercado usado nas buscas e no /tracks (ISO 3166-1 alpha-2). Padrao: BR
SPOTIFY_MARKET=BR

# Chave da OpenRouter para a explicacao via LLM (DeepSeek via OpenRouter).
# Modelo: deepseek/deepseek-chat. Necessaria para o endpoint /api/diagnose.
OPENROUTER_API_KEY=sk-or-v1-your-key-here