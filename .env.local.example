# ---------------------------------------------------------------------------
# Explicacao escrita do diagnostico (opcional)
#
# Como conseguir a chave:
#   1. entre em https://openrouter.ai e faca login
#   2. abra https://openrouter.ai/keys e clique em "Create key"
#   3. copie a chave inteira: comeca com sk-or-v1- e tem ~70 caracteres
#   4. cole abaixo, salve, e REINICIE o servidor (o Next so le este arquivo ao subir)
#
# Sem chave valida o app funciona igual: a nota e o intervalo saem do modelo
# local e nao dependem de LLM nenhum. So o paragrafo em portugues some.
OPENROUTER_API_KEY=

# Modelo usado na explicacao. O padrao e pago (centavos por milhar de chamadas).
# Para nao gastar nada, use um modelo com sufixo :free, por exemplo:
#   OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Busca de musicas no Spotify (opcional)
# Crie um app em https://developer.spotify.com/dashboard e copie as credenciais.
# Sem elas, o caminho "enviar uma musica" continua funcionando.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
