# ---------------------------------------------------------------------------
# Explicacao escrita do diagnostico (opcional)
#
# Como conseguir a chave:
#   1. entre em https://openrouter.ai e faca login
#   2. abra https://openrouter.ai/keys e clique em "Create key"
#   3. copie a chave inteira: comeca com sk-or-v1- e tem ~70 caracteres
#   4. cole abaixo, salve, e REINICIE o servidor (o Next so le este arquivo ao subir)
#
# Sem chave valida o app funciona igual: a nota e o intervalo saem do modelo
# local e nao dependem de LLM nenhum. So o paragrafo em portugues some.
OPENROUTER_API_KEY=

# Modelo usado na explicacao. O padrao e pago (centavos por milhar de chamadas).
# Para nao gastar nada, use um modelo com sufixo :free, por exemplo:
#   OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Modo apresentacao (/admin) entre aparelhos, com o app na Vercel
#
# Como conseguir:
#   1. entre em https://supabase.com e crie a conta
#   2. New project: qualquer nome, regiao Sao Paulo se aparecer
#   3. espere provisionar (uns 2 minutos)
#   4. Project Settings > API, copie "Project URL" e a chave "anon public"
#
# Nao precisa criar tabela, rodar SQL nem configurar login: e usado so o canal
# de broadcast do Realtime, que nao escreve em banco nenhum.
#
# Sem estas chaves o modo apresentacao continua funcionando pelo servidor do
# proprio Next, o que vale quando existe uma instancia so (sua maquina numa
# rede local, ou um VPS). Na Vercel, onde cada requisicao pode cair num
# processo diferente, ai sim elas sao necessarias.
# A chave pode se chamar `anon public` (comeca com eyJ, projetos antigos) ou
# `publishable` (comeca com sb_publishable_, projetos novos). O codigo aceita as
# duas, entao use a que o seu painel mostrar, no nome que ele sugerir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Alternativa ao Supabase, sem sair da Vercel ---------------------------
#
# No painel da Vercel: Storage > Create Database > Upstash for Redis. Ao
# conectar ao projeto, a Vercel injeta estas duas variaveis sozinha. Localmente
# voce copia elas de la para ca.
#
# Como funciona: quem apresenta grava o estado numa chave e a rota SSE le essa
# chave a cada 250ms, empurrando o que mudou. Uma conexao por espectador, em
# vez de cada navegador consultando o Redis por conta.
#
# Custo de uma apresentacao de 20 minutos com 20 pessoas: por volta de 110 mil
# comandos, dentro do plano gratuito. O ponteiro fica um pouco menos fluido que
# no Supabase, porque 250ms de leitura e o limite de quao rapido o dado chega.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Busca de musicas no Spotify (opcional)
# Crie um app em https://developer.spotify.com/dashboard e copie as credenciais.
# Sem elas, o caminho "enviar uma musica" continua funcionando.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
